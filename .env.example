# =====================================================================
# ThreadCraft V2 — Production & Local Environment Configuration
# Copy this file to .env in production (or configure in cPanel -> Setup Node.js App)
# WARNING: Never commit real production secrets or database passwords.
# =====================================================================

# 1. Server & Runtime Environment
# Set NODE_ENV=production on cPanel so the server serves compiled static assets from ./dist
NODE_ENV=development
PORT=3000

# 2. Cryptographic Security Secrets (Generate with: openssl rand -hex 32)
SESSION_SECRET=replace_with_64_char_random_hex_session_secret_in_production
CSRF_SECRET=replace_with_64_char_random_hex_csrf_secret_in_production

# 3. MySQL / MariaDB Database Credentials (Required in cPanel Production)
# In cPanel, set DB_HOST=127.0.0.1 and use your cPanel-prefixed DB name & user (e.g. cpaneluser_threadcraft)
# When DB_HOST is left blank in local preview, the server automatically uses ./database/threadcraft_v2.sqlite
DB_HOST=
DB_PORT=3306
DB_DATABASE=threadcraft_v2
DB_USERNAME=root
DB_PASSWORD=

# 4. Initial Bootstrap Administrator Provisioning (Used by: npm run provision:admin)
# Provisions the initial admin ONLY if zero admin accounts exist in the database.
# Enforces a mandatory password change (must_change_password = true) on first login.
INITIAL_ADMIN_EMAIL=admin@gmail.com
INITIAL_ADMIN_PASSWORD=admin123

# 5. Optional Server-Side Integrations
GEMINI_API_KEY=
